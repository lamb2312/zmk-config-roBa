{
  "name": "roba-keymap-tool",
  "version": "1.2.0",
  "description": "roBa キーボード キーマップ GUI ツール",
  "main": "main.js",
  "scripts": {
    "build:runtime": "node scripts/build-runtime.js",
    "prestart": "npm run build:runtime",
    "predev": "npm run build:runtime",
    "prebuild": "npm run build:runtime",
    "pretest": "npm run build:runtime",
    "test": "node --test test/*.test.js",
    "test:electron": "npm run build:runtime && node scripts/smoke-runtime.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.lamb2312.robakeymaptool",
    "productName": "roBa Keymap Tool",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "chokidar": "^4.0.3",
    "node-disk-info": "^1.3.0",
    "protobufjs": "7.6.6",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0"
  }
}
